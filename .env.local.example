# Firebase (Firebase Console → Project Settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Production URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://okurmen-kids.web.app

# Cloudinary (unsigned upload — Dashboard → Settings → Upload → Upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dsyqh5cdw
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=okurmen_uploads

# Admin emails (comma-separated) — client-side guard; Firestore rules use admins/{uid}
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
